#!/bin/sh

modem_turn_on() {
	echo "Turning modem on"
	gpioset --mode=time --sec 10 /dev/gpiochip0 16=0
	gpioset --mode=time --sec 10 /dev/gpiochip0 14=1
	sleep 10
	gpioset --mode=time --sec 10 /dev/gpiochip0 14=0
	gpioget /dev/gpiochip0 14 > /dev/null
	gpioget /dev/gpiochip0 16 > /dev/null 
}

modem_turn_off() {
	echo "Turning modem off"
	gpioset --mode=time --sec 4 /dev/gpiochip0 16=0
	gpioset --mode=time --sec 1 /dev/gpiochip0 14=1
	sleep 1
	gpioset --mode=time --sec 3 /dev/gpiochip0 14=0
	sleep 3
	gpioget /dev/gpiochip0 14 > /dev/null
	gpioget /dev/gpiochip0 16 > /dev/null
}

case $1 in
on)
	if [ ! -c "/dev/ttyACM0" ] && [ ! -c "/dev/cdc-wdm0" ]; then
		modem_turn_on
	else
		echo "Modem is on"
	fi
	;;
off)
	if [ -c "/dev/ttyACM0" ] || [ -c "/dev/cdc-wdm0" ]; then
		modem_turn_off
	else
		echo "Modem is off"
	fi
	;;
restart)
	modem_turn_off
	modem_turn_on
	;;
esac
