#!/bin/sh

modem_turn_on() {
    echo "Turning modem on"
	gpioset -z -p 10s -t 0 -c /dev/gpiochip0 16=0
    gpioset -z -p 10s -t 0 -c /dev/gpiochip0 14=1
	sleep 10
	gpioset -z -t 0 -c /dev/gpiochip0 14=0
	gpioget -c /dev/gpiochip0 14
	gpioget -c /dev/gpiochip0 16   
}

modem_turn_off() {
	echo "Turning modem off"
    gpioset -z -p 4s -t 0 -c /dev/gpiochip0 16=0
    gpioset -z -p 1s -t 0 -c /dev/gpiochip0 14=1
    sleep 1
    gpioset -z -p 3s -t 0 -c /dev/gpiochip0 14=0
	sleep 3
	gpioget -c /dev/gpiochip0 14
    gpioget -c /dev/gpiochip0 16  
}

case $1 in
on)
    if [ ! -c "/dev/ttyACM0" ] && [ ! -c "/dev/cdc-wdm0" ]; then
		modem_turn_on
    else
		echo "Modem is on"
    fi
    ;;
off)
    if [ -c "/dev/ttyACM0" ] || [ -c "/dev/cdc-wdm0" ]; then
		modem_turn_off
    else
		echo "Modem is off"
    fi
    ;;
restart)
	modem_turn_off
	modem_turn_on
    ;;
esac
